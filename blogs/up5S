  <style>
    :root { --nav-offset: 0px; }
    body { opacity: 0; }
    body.css-loaded { opacity: 1; transition: opacity 0.15s ease-in; }

    /* Blog card */
    .blog-card {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: var(--transition-smooth);
    }
    .blog-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-luxury);
    }
    .blog-card-image {
      width: 100%;
      height: 220px;
      overflow: hidden;
      border-radius: var(--radius-large) var(--radius-large) 0 0;
      margin: -36px -36px 20px -36px;
      width: calc(100% + 72px);
    }
    .blog-card-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .blog-card-tag {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--color-accent);
      margin-bottom: 10px;
    }
    .blog-card h3 {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 10px;
      line-height: 1.35;
    }
    .blog-card p {
      color: var(--color-text-muted);
      font-size: 0.92rem;
      line-height: 1.6;
      margin-bottom: 16px;
      flex-grow: 1;
    }
    .blog-card-meta {
      font-size: 0.78rem;
      color: var(--color-text-muted);
      margin-bottom: 16px;
    }
    .blog-card-link {
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--color-accent);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    @media (max-width: 768px) {
      .grid-3-col.blog-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
